# Frontend Environment Configuration Example

# Google OAuth Sign-In Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Apple OAuth Feature Toggle
# Set to 'false' (default) to disable Apple Sign-In during local development or pending Apple Developer Program setup.
# Set to 'true' only when valid Apple credentials are provided below.
NEXT_PUBLIC_APPLE_SIGN_IN_ENABLED=false

# Apple OAuth Credentials (Required only when NEXT_PUBLIC_APPLE_SIGN_IN_ENABLED=true)
# NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id_here
# NEXT_PUBLIC_APPLE_REDIRECT_URI=https://yourdomain.com/login
