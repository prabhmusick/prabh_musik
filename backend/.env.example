# Select the database used by the Express API: local or cloudflare
DB_MODE=cloudflare

# Cloudflare D1 HTTP adapter
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_database_id
CLOUDFLARE_API_TOKEN=your_scoped_cloudflare_api_token

# Local development only
# DB_MODE=local
# DB_FILE=./Database/beats.db

# Razorpay checkout
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# R2 storage
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket

# R2 Public Media Storage Custom Domain
R2_PUBLIC_URL=https://media.prabhmusik.com

# Backend Public Service URL
BACKEND_PUBLIC_URL=https://your-backend.example.com

# Resend purchase confirmation emails
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Prabh Musik <support@prabhmusik.com>
# Maximum raw audio attachment bytes per purchase email; larger files use expiring download links.
PURCHASE_EMAIL_MAX_ATTACHMENT_BYTES=26214400
PURCHASE_EMAIL_LINK_EXPIRY_SECONDS=604800
